#!/usr/bin/env bash
# bin/dotfiles — dotfiles CLI
# github.com/zeraphie/i-dotfiles
#
# Usage:
#   dotfiles link .           — interactive fzf picker (falls back to numbered list)
#   dotfiles link . --all     — copy everything without prompting
#   dotfiles link /path/to/project
#   dotfiles status .         — show which configs are up to date / modified / missing
#   dotfiles unlink .         — remove copied files and clean .git/info/exclude
#
# Files are copied (not symlinked) so they can be edited freely in each project.
# Use 'dotfiles status' to see if they have drifted from the source.

set -euo pipefail

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { printf "${BLUE}${BOLD}  →${RESET}  %s\n" "$*"; }
success() { printf "${GREEN}${BOLD}  ✓${RESET}  %s\n" "$*"; }
warn()    { printf "${YELLOW}${BOLD}  !${RESET}  %s\n" "$*"; }
error()   { printf "${RED}${BOLD}  ✗${RESET}  %s\n" "$*" >&2; }
header()  { printf "\n${MAGENTA}${BOLD}  %s${RESET}\n\n" "$*"; }

# ── Resolve DOTFILES root ─────────────────────────────────────────────────────
# The script lives in $DOTFILES/bin/dotfiles, so DOTFILES is one level up.
DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ── Items ─────────────────────────────────────────────────────────────────────
# Each entry: "display name|source (relative to DOTFILES)|destination (relative to project)"
declare -a ITEMS=(
  "Style Guide|ai/STYLE.md|.ai/STYLE.md"
  "Security rules|ai/SECURITY.md|.ai/SECURITY.md"
  "Claude Code config|ai/CLAUDE.md|CLAUDE.md"
  "Slash: /enforce-style|ai/commands/enforce-style.md|.claude/commands/enforce-style.md"
  "Slash: /review-security|ai/commands/review-security.md|.claude/commands/review-security.md"
  "Slash: /setup-project|ai/commands/setup-project.md|.claude/commands/setup-project.md"
  "Zed settings|ai/templates/zed/settings.json|.zed/settings.json"
  "oxlint config|ai/templates/project/.oxlintrc.json|.oxlintrc.json"
  "oxfmt config|ai/templates/project/.oxfmtrc.json|.oxfmtrc.json"
  "commitlint config|ai/templates/project/commitlint.config.js|commitlint.config.js"
  "vitest config|ai/templates/project/vitest.config.js|vitest.config.js"
  "CI workflow|ai/templates/project/.github/workflows/ci.yml|.github/workflows/ci.yml"
)

# ── Helpers ───────────────────────────────────────────────────────────────────

resolve_project() {
  local target="${1:-.}"
  if [[ "$target" == "." ]]; then
    echo "$PWD"
  else
    cd "$target" && pwd
  fi
}

assert_git_repo() {
  local project="$1"
  if [[ ! -d "$project/.git" ]]; then
    error "$project is not a git repository"
    exit 1
  fi
}

# Add a path to .git/info/exclude so it is ignored locally without touching .gitignore
exclude_locally() {
  local project="$1"
  local path="$2"
  local exclude_file="$project/.git/info/exclude"

  if grep -qxF "$path" "$exclude_file" 2>/dev/null; then
    return
  fi

  echo "$path" >> "$exclude_file"
}

# Remove a path from .git/info/exclude
clean_exclude() {
  local project="$1"
  local path="$2"
  local exclude_file="$project/.git/info/exclude"

  if [[ ! -f "$exclude_file" ]]; then
    return
  fi

  # Avoid sed -i portability issues between macOS and Linux — use a tmp file
  grep -vxF "$path" "$exclude_file" > "${exclude_file}.tmp" \
    && mv "${exclude_file}.tmp" "$exclude_file"
}

# Copy a source file into the project.
# - If destination content matches source: report "up to date", skip copy.
# - If destination differs: back it up, then copy fresh.
# - If destination is absent: create parent dirs and copy.
copy_item() {
  local project="$1"
  local src="$2"
  local dst_rel="$3"
  local dst="$project/$dst_rel"

  if [[ ! -f "$src" ]]; then
    error "Source does not exist: $src"
    return 1
  fi

  # Create parent directories if needed
  local parent
  parent="$(dirname "$dst")"
  if [[ ! -d "$parent" ]]; then
    mkdir -p "$parent"
  fi

  # Already up to date — nothing to do
  if [[ -f "$dst" ]] && diff -q "$src" "$dst" &>/dev/null; then
    printf "  ${GREEN}✓${RESET}  ${CYAN}%-44s${RESET} up to date\n" "$dst_rel"
    exclude_locally "$project" "$dst_rel"
    return
  fi

  # Destination exists but differs — back it up before overwriting
  if [[ -f "$dst" ]]; then
    local backup="${dst}.backup.$(date +%Y%m%d_%H%M%S)"
    warn "Backing up modified: $dst_rel → $(basename "$backup")"
    cp "$dst" "$backup"
  fi

  cp "$src" "$dst"
  exclude_locally "$project" "$dst_rel"
  printf "  ${GREEN}✓${RESET}  ${CYAN}%-44s${RESET} copied\n" "$dst_rel"
}

# ── Pickers ───────────────────────────────────────────────────────────────────

# fzf multi-picker — prints indices of selected items to stdout
pick_with_fzf() {
  local -a names
  names=()
  local i=0
  for item in "${ITEMS[@]}"; do
    names+=("$(echo "$item" | cut -d'|' -f1)")
    ((i++)) || true
  done

  local selected
  selected="$(printf '%s\n' "${names[@]}" | fzf \
    --multi \
    --prompt='Select items to copy (TAB to select, ENTER to confirm): ' \
    --header='dotfiles → project' \
    --preview-window=hidden \
    --height=~50% \
    --border=rounded \
    --color='prompt:#89b4fa,header:#cba6f7,pointer:#f38ba8,marker:#a6e3a1'
  )"

  # Map selected display names back to their indices
  i=0
  for item in "${ITEMS[@]}"; do
    local name
    name="$(echo "$item" | cut -d'|' -f1)"
    if echo "$selected" | grep -qxF "$name"; then
      echo "$i"
    fi
    ((i++)) || true
  done
}

# Fallback numbered-list picker when fzf is not available
pick_with_list() {
  echo ""
  local i=1
  for item in "${ITEMS[@]}"; do
    local name
    name="$(echo "$item" | cut -d'|' -f1)"
    printf "  ${CYAN}%2d${RESET}  %s\n" "$i" "$name"
    ((i++)) || true
  done

  echo ""
  printf "  ${CYAN}?  ${RESET}Enter numbers to copy (e.g. 1 3 5), ${BOLD}a${RESET} for all, ${BOLD}q${RESET} to quit: "
  read -r answer

  if [[ "$answer" == "q" ]]; then
    echo "Aborted."
    exit 0
  fi

  if [[ "$answer" == "a" ]]; then
    local j=0
    for _ in "${ITEMS[@]}"; do
      echo "$j"
      ((j++)) || true
    done
    return
  fi

  for num in $answer; do
    local idx=$((num - 1))
    if [[ "$idx" -ge 0 && "$idx" -lt "${#ITEMS[@]}" ]]; then
      echo "$idx"
    fi
  done
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_link() {
  local target="${1:-.}"
  local all=false

  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|-a) all=true ;;
      *) warn "Unknown flag: $1" ;;
    esac
    shift
  done

  local project
  project="$(resolve_project "$target")"

  assert_git_repo "$project"

  header "dotfiles → $(basename "$project")"
  info "Dotfiles: $DOTFILES"
  info "Project:  $project"
  echo ""

  local -a selected_indices
  selected_indices=()

  if [[ "$all" == true ]]; then
    local i=0
    for _ in "${ITEMS[@]}"; do
      selected_indices+=("$i")
      ((i++)) || true
    done
  elif command -v fzf &>/dev/null; then
    while IFS= read -r line; do
      selected_indices+=("$line")
    done < <(pick_with_fzf)
    echo ""
  else
    while IFS= read -r line; do
      selected_indices+=("$line")
    done < <(pick_with_list)
    echo ""
  fi

  if [[ "${#selected_indices[@]}" -eq 0 ]]; then
    warn "Nothing selected."
    exit 0
  fi

  for idx in "${selected_indices[@]}"; do
    local item="${ITEMS[$idx]}"
    local src_rel dst_rel
    src_rel="$(echo "$item" | cut -d'|' -f2)"
    dst_rel="$(echo "$item" | cut -d'|' -f3)"

    copy_item "$project" "$DOTFILES/$src_rel" "$dst_rel"
  done

  echo ""
  success "Done! Files are excluded from git via .git/info/exclude."
}

cmd_status() {
  local target="${1:-.}"
  local project
  project="$(resolve_project "$target")"

  assert_git_repo "$project"

  header "Dotfile status in $(basename "$project")"

  for item in "${ITEMS[@]}"; do
    local name src_rel dst_rel
    name="$(echo "$item" | cut -d'|' -f1)"
    src_rel="$(echo "$item" | cut -d'|' -f2)"
    dst_rel="$(echo "$item" | cut -d'|' -f3)"
    local src="$DOTFILES/$src_rel"
    local dst="$project/$dst_rel"

    if [[ ! -f "$dst" ]]; then
      printf "  ${RED}✗${RESET}  ${BOLD}%-32s${RESET}  ${RED}not present${RESET}  %s\n" "$name" "$dst_rel"
    elif diff -q "$src" "$dst" &>/dev/null; then
      printf "  ${GREEN}✓${RESET}  ${BOLD}%-32s${RESET}  ${GREEN}up to date${RESET}  %s\n" "$name" "$dst_rel"
    else
      printf "  ${YELLOW}!${RESET}  ${BOLD}%-32s${RESET}  ${YELLOW}modified${RESET}    %s\n" "$name" "$dst_rel"
    fi
  done

  echo ""
}

cmd_unlink() {
  local target="${1:-.}"
  local project
  project="$(resolve_project "$target")"

  assert_git_repo "$project"

  header "Remove dotfiles from $(basename "$project")"

  local found=false
  for item in "${ITEMS[@]}"; do
    local dst_rel
    dst_rel="$(echo "$item" | cut -d'|' -f3)"
    local dst="$project/$dst_rel"

    if [[ -f "$dst" ]]; then
      rm "$dst"
      clean_exclude "$project" "$dst_rel"
      found=true
      success "Removed: $dst_rel"
    fi
  done

  if [[ "$found" == false ]]; then
    info "No dotfile copies found in this project."
  fi

  echo ""
}

cmd_help() {
  printf "\n${MAGENTA}${BOLD}  dotfiles${RESET} — copy i-dotfiles config into any project\n\n"
  printf "  ${BOLD}Usage:${RESET}\n"
  printf "    dotfiles link [path] [--all]   Copy configs into a project\n"
  printf "    dotfiles status [path]         Show which configs are current / modified / missing\n"
  printf "    dotfiles unlink [path]         Remove copied files from a project\n"
  printf "    dotfiles help                  Show this help\n"
  printf "\n"
  printf "  ${BOLD}Options:${RESET}\n"
  printf "    --all, -a    Skip the picker and copy everything\n"
  printf "    path         Project directory (defaults to current directory)\n"
  printf "\n"
  printf "  ${BOLD}Examples:${RESET}\n"
  printf "    dotfiles link .               Interactive picker in current dir\n"
  printf "    dotfiles link . --all         Copy everything to current dir\n"
  printf "    dotfiles link ~/projects/foo  Interactive picker for another project\n"
  printf "    dotfiles status .             See what is current / modified / missing\n"
  printf "    dotfiles unlink .             Remove all copied dotfiles from project\n"
  printf "\n"
  printf "  ${BOLD}Notes:${RESET}\n"
  printf "    Files are copied, not symlinked, so you can edit them freely in each\n"
  printf "    project. Run 'dotfiles status' to see if they have drifted from source.\n"
  printf "    Copied files are added to .git/info/exclude — they will not appear in\n"
  printf "    git status or be accidentally committed.\n\n"
}

# ── Entrypoint ────────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  link)           cmd_link "$@" ;;
  status)         cmd_status "$@" ;;
  unlink)         cmd_unlink "$@" ;;
  help|--help|-h) cmd_help ;;
  *)
    error "Unknown command: $COMMAND"
    cmd_help
    exit 1
    ;;
esac
